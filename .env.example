# ============================================================
# VitalTrace Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ── Supabase Client Configuration (safe for browser bundle) ──
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Administrator Configuration ──────────────────────────────
# LOCAL OFFLINE MODE ONLY: Identifies the single offline admin account.
# In Supabase (production) mode, admin role is determined exclusively by
# the database column public.profiles.role = 'admin', provisioned via:
#   UPDATE public.profiles SET role = 'admin' WHERE id = '<uuid>';
# Do NOT use this env var to control production admin access.
VITE_LOCAL_ADMIN_EMAIL=admin@vitaltrace.internal

# ── Power BI Embedding (optional) ────────────────────────────
# If you publish the Power BI report to Power BI Service and want to
# embed it in the /admin/powerbi route, set these values.
# Leave blank to use the Power BI Resources & Documentation Hub instead.
# See docs/powerbi-setup.md for instructions.
# VITE_POWERBI_EMBED_URL=https://app.powerbi.com/reportEmbed?reportId=...

# ── Server-Side Secrets: NEVER in frontend .env ──────────────
# Configure these in Supabase Dashboard → Project Settings → Edge Functions Secrets:
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key
#   supabase secrets set GEMINI_MODEL=gemini-2.0-flash
#
# These secrets must NEVER appear in VITE_* variables or browser-accessible code:
#   GEMINI_API_KEY=...           (server-side only)
#   SUPABASE_SERVICE_ROLE_KEY=..  (server-side only)
