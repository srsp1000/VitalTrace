{
  "name": "VitalTrace Analytics",
  "dataColors": [
    "#0d9488",
    "#3b82f6",
    "#10b981",
    "#f59e0b",
    "#6366f1",
    "#ef4444",
    "#0284c7",
    "#8b5cf6"
  ],
  "background": "#f8fafc",
  "foreground": "#1e293b",
  "tableAccent": "#0d9488",
  "bad": "#ef4444",
  "neutral": "#f59e0b",
  "good": "#10b981",
  "minimum": "#ef4444",
  "center": "#f59e0b",
  "maximum": "#0d9488",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI",
      "fontSize": 28,
      "color": "#0d9488"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#0f172a"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1e293b"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9.5,
      "color": "#64748b"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "color": { "solid": { "color": "#1e293b" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#ffffff" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#e2e8f0" } },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#0f172a" } },
            "transparency": 95,
            "position": "Outer",
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0f172a" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#0d9488" } },
            "fontSize": 26,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748b" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": { "solid": { "color": "#475569" } }
          }
        ],
        "dataLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#1e293b" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#64748b" } },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#64748b" } },
            "fontSize": 9,
            "gridlineStyle": "dotted"
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "dataLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#1e293b" } },
            "fontSize": 9
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "legend": [
          {
            "show": true,
            "position": "Top",
            "fontFamily": "Segoe UI",
            "fontSize": 9,
            "labelColor": { "solid": { "color": "#475569" } }
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#64748b" } },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#64748b" } },
            "fontSize": 9,
            "gridlineStyle": "dotted"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#f1f5f9" } },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#0f172a" } },
            "backColor": { "solid": { "color": "#f8fafc" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#1e293b" } },
            "fontFamily": "Segoe UI",
            "fontSize": 9.5
          }
        ]
      }
    }
  }
}
